# GOGETA admin panel — environment variables
# Copy to `.env.local` and set the value. See DEPLOYMENT.md.

# Full URL of the deployed GOGETA API, including the /api prefix.
# Local dev example below; in production point this at the hosted API,
# e.g. https://api.example.com/api
NEXT_PUBLIC_API_BASE=http://localhost:4000/api

# ── Solana (payouts) ───────────────────────────────────────────────────────
# Used on the Withdrawals page so an admin can sign a payout from their own
# wallet via the Solana wallet adapter. No project id or third-party service is
# involved — the adapter talks to the browser extension directly.
#
# Mirrors the user portal's VITE_SOLANA_* values; the backend re-verifies every
# one of them when it checks a payout, so these are for display and for building
# the transaction, never for authorising it.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_EXPLORER_URL=https://explorer.solana.com
NEXT_PUBLIC_SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
